{
  "enabled": {
    "description": "启用蕾缪安补充上下文",
    "type": "bool",
    "default": false,
    "hint": "需同时选择对应人格，并把会话加入下面的列表。"
  },
  "allowed_sessions": {
    "description": "允许的会话（支持通配符）",
    "type": "list",
    "default": [],
    "hint": "填写统一消息来源 UMO。napcat:FriendMessage:* 表示该 QQ 连接的全部私聊；空列表不启用任何会话。"
  },
  "persona_id": {
    "description": "人格名称",
    "type": "string",
    "default": "蕾缪安"
  },
  "knowledge_base": {
    "description": "原作知识库名称",
    "type": "string",
    "default": "蕾缪安"
  },
  "top_k": {
    "description": "每次检索条数",
    "type": "int",
    "default": 5,
    "hint": "范围 1–10。"
  },
  "retrieval_timeout_seconds": {
    "description": "检索等待上限（秒）",
    "type": "int",
    "default": 8,
    "hint": "超时后继续使用人格和常驻表达参考。范围 1–30。"
  },
  "proactive": {
    "type": "object",
    "description": "低频主动私聊",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用主动聊天",
        "default": false
      },
      "targets": {
        "type": "list",
        "description": "主动聊天收件会话（精确 UMO，不支持通配符）",
        "default": []
      },
      "weekdays": {
        "type": "list",
        "description": "星期（1=周一，7=周日）",
        "default": [
          1,
          3,
          6
        ]
      },
      "start_hour": {
        "type": "int",
        "description": "开始时间（北京时间，小时）",
        "default": 19
      },
      "end_hour": {
        "type": "int",
        "description": "结束时间（北京时间，小时）",
        "default": 21
      },
      "idle_minutes": {
        "type": "int",
        "description": "最近对话后至少等待多少分钟",
        "default": 120
      }
    }
  }
}
